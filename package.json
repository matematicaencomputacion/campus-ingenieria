{
  "name": "campus-ingenieria",
  "version": "1.0.0",
  "description": "Plataforma de aprendizaje y lecciones interactivas para ingeniería",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash serve.sh 3000",
    "test": "node scripts/smoke-test.mjs && node --test scripts/*unit.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:interaction": "node scripts/interaction-smoke.mjs",
    "test:all": "npm test && npm run test:browser && npm run test:interaction && npm run test:navigation && npm run test:l200 && npm run test:l201",
    "css:snapshot": "node scripts/computed-style-check.mjs",
    "check": "node scripts/smoke-test.mjs",
    "reconcile": "bash scripts/reconcile-live.sh --dry-run",
    "test:navigation": "node --test scripts/navigation-test.mjs",
    "test:l200": "node --test scripts/l200-easy-test.mjs",
    "test:l201": "node --test scripts/l201-media-test.mjs"
  },
  "keywords": [
    "campus",
    "ingenieria",
    "matematica",
    "desmos",
    "stem"
  ],
  "author": "Cátedra Matemática",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
